# GuardianRS Environment Secrets
# Copy this file to /opt/guardianrs/.env (mode 0600) and fill in real values.
# NEVER commit .env to version control.

# Discord HTTPS webhook endpoint (https://discord.com/api/webhooks/<id>/<token>)
DISCORD_WEBHOOK_URL=

# Per-instance PostgreSQL probe & backup credentials (referenced by configs/guardian.yaml)
GUARDIAN_PG_AUDITOR_PASSWORD=
GUARDIAN_PG_PEDIDOS_PASSWORD=
GUARDIAN_PG_ECOMMERCE_PASSWORD=
GUARDIAN_PG_NUTRITION_PASSWORD=
